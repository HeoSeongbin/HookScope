{
  "name": "@hookscope/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run",
    "smoke": "tsx src/smoke.ts",
    "smoke:filters": "tsx src/filterSmoke.ts",
    "smoke:response": "tsx src/responseSmoke.ts",
    "worker": "tsx --env-file=../.env src/worker.ts",
    "smoke:replay": "tsx src/replaySmoke.ts",
    "smoke:analytics": "tsx src/analyticsSmoke.ts"
  },
  "dependencies": {
    "bullmq": "^5.81.6",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "pino": "^10.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
